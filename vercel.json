{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "stitch_manish_singh_3d_portfolio",
  "cleanUrls": false,
  "trailingSlash": false,
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/(home|about|work|project-details|skills|contact)/?$", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
